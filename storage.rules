rules_version = '2';

// Règles Storage de Sacko-Green. Tout est fermé par défaut : chaque étape
// ouvre le dossier dont elle a besoin (photos de véhicules, documents de
// dédouanement…) avec les mêmes claims que firestore.rules.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
