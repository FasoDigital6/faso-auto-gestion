# Copier ce fichier en .env.local et le remplir avec les valeurs du projet
# Firebase de Sacko-Green (sackogreen-dev en développement). Ne jamais commiter .env.local.

# Firebase (console Firebase > Paramètres du projet > Vos applications)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Compte de service (console Firebase > Comptes de service > Générer une clé privée)
SERVICE_ACCOUNT_CLIENT_EMAIL=
SERVICE_ACCOUNT_PRIVATE_KEY=

# Cookie de session (deux chaînes aléatoires d'au moins 32 caractères)
AUTH_COOKIE_NAME=sackogreen_session
COOKIE_SECRET_CURRENT=
COOKIE_SECRET_PREVIOUS=
USE_SECURE_COOKIES=false

# E-mails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Émulateurs Firebase (tests e2e uniquement)
NEXT_PUBLIC_EMULATOR=false
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1
